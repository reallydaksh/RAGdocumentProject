# Copy this file to .env and fill in ONE provider's key.
# Gemini has a free tier: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Or use OpenAI: set LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Retrieval tuning (optional)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
